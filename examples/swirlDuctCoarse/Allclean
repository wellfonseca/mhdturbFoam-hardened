#!/bin/sh
cd "${0%/*}" || exit 1

#------------------------------------------------------------------------------
# Allclean - swirlDuctCoarse
#
# The mesh is GENERATED by Allrun, so this removes the mesh and the extracted
# features as well, leaving only the tracked input files.
#------------------------------------------------------------------------------

echo "Allclean: removendo malha, recursos extraidos, tempos, postProcessing e log.*"

rm -rf constant/polyMesh
rm -rf constant/extendedFeatureEdgeMesh
rm -f  constant/triSurface/*.eMesh
rm -rf postProcessing
rm -rf processor*
rm -f  log.*
rm -rf [1-9]* [0-9]*.[0-9]*

ls
